#!/system/bin/sh
# CMS-2026 CLI Tool
# Version: 2.0.0
# Author: clcwpwqi

MODDIR=${0%/*}
CMS2026_DIR="/data/local/cms2026"
BIN_PATH="$CMS2026_DIR/cms2026_bin"

show_help() {
    cat << EOF
CMS-2026 Secure Encryption Tool v2.0.0

Usage: cms2026 [OPTIONS]

OPTIONS:
    -e, --encrypt <text>     Encrypt the given text
    -d, --decrypt <text>     Decrypt the given ciphertext
    -p, --password <pwd>     Set encryption/decryption password
    --strong                 Use strong encryption mode (256-bit key)
    -o, --output <file>      Write output to file instead of stdout
    -i, --input <file>       Read input from file instead of argument
    -h, --help               Show this help message
    -v, --version            Show version information

EXAMPLES:
    # Encrypt a string
    cms2026 -e "Hello World" -p "mypassword"

    # Decrypt a ciphertext
    cms2026 -d "U2FsdGVkX1..." -p "mypassword"

    # Strong encryption mode
    cms2026 -e "Secret data" -p "strongpass" --strong

    # Read from file
    cms2026 -e -i input.txt -p "pass" -o output.enc

Note: For WebUI, please use the CMS-2026 Web Interface.

EOF
}

show_version() {
    echo "CMS-2026 CLI Tool v2.0.0"
    echo "Author: clcwpqi"
}

initialize_env() {
    if [ ! -d "$CMS2026_DIR" ]; then
        mkdir -p "$CMS2026_DIR"
        chmod 755 "$CMS2026_DIR"
    fi
    
    if [ ! -L "$BIN_PATH" ] && [ -f "$MODDIR/bin/cms2026" ]; then
        cp -f "$MODDIR/bin/cms2026" "$BIN_PATH"
        chmod 755 "$BIN_PATH"
    fi
}

derive_key() {
    local password="$1"
    local salt="$2"
    local key_len="$3"
    
    if [ -n "$salt" ]; then
        echo -n "$password$salt" | sha256sum | cut -d' ' -f1
    else
        echo -n "$password" | sha256sum | cut -d' ' -f1
    fi
}

cms2026_encrypt() {
    local plaintext="$1"
    local password="$2"
    local strong="$3"
    
    if [ -z "$plaintext" ] || [ -z "$password" ]; then
        echo "Error: Plaintext and password are required" >&2
        return 1
    fi
    
    local salt="$(date +%s%N | sha256sum | cut -c1-16)"
    local iv="$(date +%s%N | sha256sum | cut -c1-16)"
    
    local key
    if [ "$strong" = "true" ]; then
        key="$(echo -n "${password}${salt}" | sha256sum | cut -d' ' -f1)"
        key="$(echo -n "${key}${iv}" | sha256sum | cut -d' ' -f1)"
    else
        key="$(derive_key "$password" "$salt" "128")"
    fi
    
    local encoded_text="$(echo -n "$plaintext" | base64)"
    
    local cipher
    if command -v openssl >/dev/null 2>&1; then
        cipher="$(echo -n "$encoded_text" | openssl enc -aes-256-cbc -K "$key" -iv "$iv" -A -a 2>/dev/null)"
        if [ $? -ne 0 ] || [ -z "$cipher" ]; then
            cipher="$(echo -n "$encoded_text" | tr -d '\n' | xxd -p | tr -d '\n' | fold -w2 | while read c; do printf "\x$(printf "%x" $((0x$c ^ 0x${key:0:2})) )"; done | head -c ${#encoded_text} | base64)"
        fi
    else
        cipher="$(echo -n "$encoded_text" | tr -d '\n' | xxd -p | tr -d '\n' | fold -w2 | while read c; do printf "\x$(printf "%x" $((0x$c ^ 0x${key:0:2})) )"; done | head -c ${#encoded_text} | base64)"
    fi
    
    local result="CMS2026:2.0:$(echo -n "$strong" | sed 's/true/S/s; s/false/B/s'):$salt:$iv:$cipher"
    echo "$result"
}

cms2026_decrypt() {
    local ciphertext="$1"
    local password="$2"
    
    if [ -z "$ciphertext" ] || [ -z "$password" ]; then
        echo "Error: Ciphertext and password are required" >&2
        return 1
    fi
    
    if ! echo "$ciphertext" | grep -q "^CMS2026:"; then
        echo "Error: Invalid ciphertext format" >&2
        return 1
    fi
    
    local version="$(echo "$ciphertext" | cut -d: -f2)"
    local mode="$(echo "$ciphertext" | cut -d: -f3)"
    local salt="$(echo "$ciphertext" | cut -d: -f4)"
    local iv="$(echo "$ciphertext" | cut -d: -f5)"
    local cipher="$(echo "$ciphertext" | cut -d: -f6)"
    
    local strong="false"
    [ "$mode" = "S" ] && strong="true"
    
    local key
    if [ "$strong" = "true" ]; then
        key="$(echo -n "${password}${salt}" | sha256sum | cut -d' ' -f1)"
        key="$(echo -n "${key}${iv}" | sha256sum | cut -d' ' -f1)"
    else
        key="$(derive_key "$password" "$salt" "128")"
    fi
    
    local decoded
    if command -v openssl >/dev/null 2>&1; then
        decoded="$(echo -n "$cipher" | openssl enc -aes-256-cbc -K "$key" -iv "$iv" -d -A -a 2>/dev/null)"
        if [ $? -ne 0 ] || [ -z "$decoded" ]; then
            decoded="$(echo -n "$cipher" | base64 -d 2>/dev/null | xxd -p | tr -d '\n' | fold -w2 | while read c; do printf "\x$(printf "%x" $((0x$c ^ 0x${key:0:2})) )"; done)"
        fi
    else
        decoded="$(echo -n "$cipher" | base64 -d 2>/dev/null | xxd -p | tr -d '\n' | fold -w2 | while read c; do printf "\x$(printf "%x" $((0x$c ^ 0x${key:0:2})) )"; done)"
    fi
    
    echo "$decoded" | base64 -d 2>/dev/null
}

main() {
    initialize_env
    
    local mode=""
    local text=""
    local password=""
    local strong="false"
    local output_file=""
    local input_file=""
    
    while [ $# -gt 0 ]; do
        case "$1" in
            -e|--encrypt)
                mode="encrypt"
                shift
                if [ -n "$1" ] && [ "${1:0:1}" != "-" ]; then
                    text="$1"
                    shift
                fi
                ;;
            -d|--decrypt)
                mode="decrypt"
                shift
                if [ -n "$1" ] && [ "${1:0:1}" != "-" ]; then
                    text="$1"
                    shift
                fi
                ;;
            -p|--password)
                shift
                password="$1"
                shift
                ;;
            --strong)
                strong="true"
                shift
                ;;
            -o|--output)
                shift
                output_file="$1"
                shift
                ;;
            -i|--input)
                shift
                input_file="$1"
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            *)
                if [ -z "$mode" ]; then
                    text="$1"
                fi
                shift
                ;;
        esac
    done
    
    if [ -n "$input_file" ] && [ -f "$input_file" ]; then
        text="$(cat "$input_file")"
    fi
    
    if [ -z "$mode" ]; then
        echo "Error: Please specify -e (encrypt) or -d (decrypt)" >&2
        show_help
        exit 1
    fi
    
    if [ -z "$text" ]; then
        echo "Error: No text provided" >&2
        show_help
        exit 1
    fi
    
    if [ -z "$password" ]; then
        echo "Error: Password is required (-p)" >&2
        exit 1
    fi
    
    local result=""
    case "$mode" in
        encrypt)
            result="$(cms2026_encrypt "$text" "$password" "$strong")"
            ;;
        decrypt)
            result="$(cms2026_decrypt "$text" "$password")"
            ;;
    esac
    
    if [ $? -eq 0 ] && [ -n "$result" ]; then
        if [ -n "$output_file" ]; then
            echo "$result" > "$output_file"
            echo "Output written to: $output_file"
        else
            echo "$result"
        fi
    else
        echo "Error: Operation failed" >&2
        exit 1
    fi
}

main "$@"
